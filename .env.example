# Copy this file to .env (already gitignored) and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# From https://id.pagar.me > Account Settings > Keys.
CONNECT_STONE_SECRET_KEY=

# Optional. Unique partner reference id assigned by the Stone Partner program. Connect Stone's
# docs list this as required, but a working reference integration doesn't send it, so leave it
# blank if you don't have one, the header is simply omitted when this is empty.
CONNECT_STONE_SERVICE_REFERER_NAME=

# Optional. Basic-auth credentials for the webhook endpoint, set to match whatever you configured
# (or left blank) on the Pagar.me side (Account > Configurações > Webhooks). Leave both blank to
# accept unauthenticated webhooks, or set both to require them. Generate strong values with:
# openssl rand -hex 16
CONNECT_STONE_WEBHOOK_USERNAME=
CONNECT_STONE_WEBHOOK_PASSWORD=
